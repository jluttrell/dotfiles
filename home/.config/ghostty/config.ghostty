# Match the current WezTerm appearance.
theme = Rose Pine Moon
font-size = 15

background-opacity = 0.8
background-blur = 50

# WezTerm's RESIZE decoration mode keeps the frame but hides the titlebar.
macos-titlebar-style = hidden

# Match WezTerm's one-cell horizontal and half-cell vertical padding at 15 pt.
window-padding-x = 9
window-padding-y = 9
